{
  "name": "deepseek-rainbow-fart",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness WebUI TTS plugin: summarize the user's message with their own LLM and speak it with offline sherpa-onnx TTS",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "bash scripts/package.sh",
    "release": "bash scripts/release.sh",
    "build:core": "bun run --cwd packages/core build",
    "test:install": "node --test scripts/install.test.js"
  }
}
