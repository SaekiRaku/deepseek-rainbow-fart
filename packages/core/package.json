{
  "name": "deepseek-rainbow-fart-core",
  "version": "0.1.0",
  "description": "DeepSeek Harness WebUI TTS plugin: summarize the user's message with their own LLM and speak it via offline sherpa-onnx TTS",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-rainbow-fart/models": "file:../models",
    "fflate": "^0.8.2",
    "lucide-react": "^0.460.0",
    "sherpa-onnx-node": "^1.13.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "speaker": "^1.0.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "speaker": {
      "optional": true
    }
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:node": "esbuild src/index.ts --format=esm --platform=node --target=node22 --external:@deepseek-ai/* --external:sherpa-onnx-node --external:@deepseek-rainbow-fart/models --outfile=lib/index.js",
    "build:client": "esbuild src/client/index.ts --bundle --format=cjs --platform=browser --external:@deepseek-ai/* --outfile=lib/client.js",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
