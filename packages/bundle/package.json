{
  "name": "deepseek-rainbow-fart",
  "version": "0.1.0",
  "description": "DeepSeek Harness Rainbow Fart offline TTS plugin bundle",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "models",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "sherpa-onnx-node": "^1.13.5"
  },
  "bundleDependencies": [
    "sherpa-onnx-node"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
